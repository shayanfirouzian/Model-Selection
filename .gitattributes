# Keep line-oriented data and source text portable across platforms.
*.py text eol=lf
*.sh text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.ipynb text eol=lf
*.csv text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.bib text eol=lf
*.tex text eol=lf
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
